{
  "name": "dsh-ghostscreen-mcp",
  "version": "0.2.4",
  "description": "Mount the GhostScreen (Neutrino) MCP server in DSH sessions: invisible-window capture and input for native apps and headless web; auto-downloads and silently updates the server on every start",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "screenshots.json",
    "screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots", "locale"],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.6 <1.0.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5-0 <4.0.0-0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ghostscreen",
    "neutrino",
    "mcp"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodtong/dsh-ghostscreen-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/woodtong/dsh-ghostscreen-mcp/issues"
  },
  "homepage": "https://github.com/woodtong/dsh-ghostscreen-mcp#readme"
}
